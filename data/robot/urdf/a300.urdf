  <joint name="lidar3d_0_joint" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.25 0.0 0.24"/>
    <parent link="base_link"/>
    <child link="lidar3d_0_link"/>
  </joint>
  <link name="lidar3d_0_laser">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
